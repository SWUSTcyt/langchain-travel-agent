# QWEN配置
DASHSCOPE_API_KEY=sk-XXXXXXXXX
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#高德地图配置
AMAP_KEY=XXXXXXXXXXX
AMAP_BASE_URL=https://restapi.amap.com/v5
AMAP_MCP_URL=https://mcp.api-inference.modelscope.net/XXXXXXXXXXXX/sse
# 高德 Web 端（JS API）的 key 和安全密钥，和上面的 MCP 地址不是同一个。
# 申请页：https://console.amap.com/dev/key/app
# 步骤说明：https://lbs.amap.com/api/javascript-api-v2/prerequisites
# 登录后进入应用管理，添加 Key 时服务平台选「Web端(JS API)」。
# Key 填 AMAP_JS_KEY，旁边的安全密钥填 AMAP_JS_SECURITY_CODE。
# 没有这两项时，页面只显示文字，地图区写「地图暂不可用」。
AMAP_JS_KEY=你的Web端JS_API_Key
AMAP_JS_SECURITY_CODE=你的安全密钥
